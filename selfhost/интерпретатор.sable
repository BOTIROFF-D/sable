// Интерпретатор Sable, написанный на Sable.
//
// Берёт дерево от parser.sable и выполняет его. Проверяется не примерами:
// tests/selfrun.ts прогоняет им настоящие программы репозитория и сверяет
// напечатанное с тем, что печатает настоящий интерпретатор — до буквы.
//
// Значения по большей части те же, что в самом Sable: число числом, строка
// строкой, список списком, словарь словарём, диапазон диапазоном. Своих
// представлений всего пять — на то, чего в языке значением не выразить:
// замыкание, определение структуры, её экземпляр, модуль и сигнал выхода.
// Из-за этого печать, `type` и сравнение приходится делать самим: настоящие
// про наши структуры ничего не знают.
//
// Встроенные функции и методы не переписываются, а зовутся настоящие —
// через мост в «встроенные.sable». Тогда их сообщения об ошибках совпадают
// сами собой, а не переписываются вручную с шансом разойтись.

import "parser.sable" as парсер
import "встроенные.sable" as мост

struct Среда {
  значения = {}
  неизменяемые = {}
  родитель = nil
}

struct Замыкание {
  имя
  параметры
  тело
  среда
}

struct Опред {
  имя
  поля
  методы
  // Область, где структура объявлена: в ней вычисляются значения полей
  // по умолчанию и живут тела методов.
  среда
}

struct Экземпляр {
  опред
  поля
}

struct Модуль {
  псевдоним
  путь
  среда
}

// Выход из блока: «return», «break», «continue». Возвращается значением, а не
// бросается: исключение на каждый return обошлось бы дороже самого вызова.
struct Сигнал {
  вид
  значение
}

// ---- области видимости -----------------------------------------------------

fn вложить(родитель) { return Среда({}, {}, родитель) }

fn объявить(с, имя, значение, изменяемая) {
  if has(с.значения, имя) { ошибка("«${имя}» уже объявлено в этой области видимости") }
  set(с.значения, имя, значение)
  if !изменяемая { set(с.неизменяемые, имя, true) }
  return nil
}

fn держит(с, имя) {
  let у = с
  while у != nil {
    if has(у.значения, имя) { return у }
    у = у.родитель
  }
  return nil
}

fn найти(с, имя) {
  let где = держит(с, имя)
  if где == nil { ошибка("имя «${имя}» не определено${подсказка(имя, имена_области(с))}") }
  return get(где.значения, имя)
}

fn присвоить(с, имя, значение) {
  let где = держит(с, имя)
  if где == nil { ошибка("нельзя присвоить необъявленному «${имя}» — начните со «let ${имя} = ...»") }
  // Встроенные лежат в самой верхней области: писать в них нельзя, но затенить
  // своим объявлением — можно, и об этом сообщение и говорит.
  if где.родитель == nil {
    ошибка("«${имя}» — встроенная функция, присваивать ей нельзя; объявите своё имя: let ${имя} = ...")
  }
  if has(где.неизменяемые, имя) { ошибка("«${имя}» объявлено через const — менять нельзя") }
  set(где.значения, имя, значение)
  return значение
}

// ---- ошибки ----------------------------------------------------------------

// Ошибка выполнения поднимается настоящим error(): так её ловит настоящий
// try/catch хозяина, а нам остаётся только передать её выше.
//
// Ошибка, поднятая самой выполняемой программой через error(значение), несёт
// с собой это значение — поэтому она заворачивается в свою структуру. Отличить
// её от ошибки хозяина по типу можно наверняка, а по ключам словаря — нет:
// такой словарь программа вправе создать и сама.
struct Наша {
  текст
  значение
}

fn ошибка(сообщение) {
  error(сообщение)
  return nil
}

fn поднять(значение) {
  error(Наша(строкой(значение), значение))
  return nil
}

// ---- подсказка про опечатку ------------------------------------------------
//
// Расстояние Левенштейна до ближайшего известного имени. Порог — треть длины,
// но не меньше единицы: иначе на коротких именах подсказка молчала бы совсем,
// а на длинных советовала бы что попало.

fn расстояние(a, b) {
  let первая = a.lower()
  let вторая = b.lower()
  let ряд = []
  for j in 0..(len(вторая) + 1) { ряд.push(j) }
  for i in 1..(len(первая) + 1) {
    let по_диагонали = ряд[0]
    ряд[0] = i
    for j in 1..(len(вторая) + 1) {
      let было = ряд[j]
      let замена = по_диагонали + (первая[i - 1] == вторая[j - 1] ? 0 : 1)
      ряд[j] = min(ряд[j] + 1, ряд[j - 1] + 1, замена)
      по_диагонали = было
    }
  }
  return ряд[len(вторая)]
}

fn подсказка(имя, известные) {
  let лучшее = nil
  let ближе_всего = -1
  for k in известные {
    let d = расстояние(имя, k)
    if ближе_всего < 0 || d < ближе_всего {
      ближе_всего = d
      лучшее = k
    }
  }
  let порог = max(1, floor(len(имя) / 3))
  if лучшее == nil || ближе_всего > порог { return "" }
  return " — возможно, имелось в виду «${лучшее}»"
}

fn имена_области(с) {
  let вышло = []
  let у = с
  while у != nil {
    for k in keys(у.значения) { вышло.push(k) }
    у = у.родитель
  }
  return вышло
}

// ---- истинность, тип, равенство --------------------------------------------

fn истинно(v) { return v != false && v != nil }

fn тип(v) {
  let t = type(v)
  if t == "Замыкание" || t == "Своя" { return "fn" }
  if t == "Опред" { return "struct" }
  if t == "Модуль" { return "module" }
  if t == "Экземпляр" { return v.опред.имя }
  return t
}

// Равенство по содержимому. Экземпляры структур сравниваются как настоящие:
// один и тот же вид и равные поля.
fn равно(a, b) {
  let ta = тип(a)
  let tb = тип(b)
  if ta != tb { return false }
  if type(a) == "Экземпляр" {
    if a.опред.имя != b.опред.имя { return false }
    return равно_словари(a.поля, b.поля)
  }
  if type(a) == "Замыкание" || type(a) == "Опред" || type(a) == "Модуль" { return a == b }
  if ta == "list" {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
      if !равно(a[i], b[i]) { return false }
    }
    return true
  }
  if ta == "map" { return равно_словари(a, b) }
  return a == b
}

fn равно_словари(a, b) {
  if len(a) != len(b) { return false }
  for k in keys(a) {
    if !has(b, k) { return false }
    if !равно(get(a, k), get(b, k)) { return false }
  }
  return true
}

// ---- печать ----------------------------------------------------------------

fn строкой(v) {
  if type(v) == "string" { return v }
  return представление(v)
}

fn представление(v) {
  let t = type(v)
  if t == "Замыкание" { return "<fn ${v.имя == nil ? "аноним" : v.имя}>" }
  if t == "Опред" { return "<struct ${v.имя}>" }
  if t == "Модуль" { return "<модуль ${v.псевдоним} из ${v.путь}>" }
  if t == "Экземпляр" {
    let части = []
    for k in keys(v.поля) { части.push("${k}: ${представление(get(v.поля, k))}") }
    return "${v.опред.имя}{${части.join(", ")}}"
  }
  if t == "list" {
    let части = []
    for э in v { части.push(представление(э)) }
    return "[${части.join(", ")}]"
  }
  if t == "map" {
    let части = []
    for k in keys(v) { части.push("${представление(k)}: ${представление(get(v, k))}") }
    return "{${части.join(", ")}}"
  }
  // Числа, строки, булевы, nil, диапазоны и настоящие встроенные печатает сам
  // язык — переписывать их форматирование значило бы заводить второй источник
  // правды о том, как выглядит 0.1 + 0.2.
  return repr(v)
}

// ---- вызовы ----------------------------------------------------------------

fn вызвать(f, аргументы) {
  let t = type(f)

  if t == "Замыкание" { return вызвать_замыкание(f, аргументы) }

  if t == "Опред" { return создать(f, аргументы) }

  // Встроенная, которую пришлось подменить: печать, сравнение и вызов обязаны
  // понимать наши структуры.
  if t == "Своя" { return своя(f.имя, аргументы) }

  // Настоящая встроенная: зовём как есть, вместе с её проверкой аргументов
  // и её сообщениями.
  if t == "fn" { return apply(f, аргументы) }

  ошибка("${тип(f)} нельзя вызвать как функцию")
  return nil
}

fn вызвать_замыкание(f, аргументы) {
  let обязательных = 0
  for п in f.параметры {
    if п.поумолчанию == nil { обязательных += 1 }
  }
  if len(аргументы) < обязательных || len(аргументы) > len(f.параметры) {
    ошибка(сообщение_об_арности(f.имя == nil ? "значение" : f.имя, len(аргументы), обязательных, len(f.параметры)))
  }

  let внутри = вложить(f.среда)
  for i in 0..len(f.параметры) {
    let п = f.параметры[i]
    let значение = i < len(аргументы) ? аргументы[i] : вычислить(п.поумолчанию, внутри)
    объявить(внутри, п.имя, значение, true)
  }

  let с = выполнить_тело(f.тело, внутри)
  if с == nil { return nil }
  if с.вид == "return" { return с.значение }
  // break и continue из тела функции наружу не выходят: цикла, который её
  // позвал, они не касаются.
  сорвался(с)
  return nil
}

fn сообщение_об_арности(имя, дано, мин, макс) {
  let нужно = мин == макс ? "${мин} ${слово_аргумент(мин)}" : "от ${мин} до ${макс} аргументов"
  return "«${имя}» ожидает ${нужно}, а получила ${дано}"
}

fn слово_аргумент(n) {
  let д = n % 10
  let с = n % 100
  if д == 1 && с != 11 { return "аргумент" }
  if д >= 2 && д <= 4 && (с < 12 || с > 14) { return "аргумента" }
  return "аргументов"
}

// Колбэку лишние аргументы не передаются: `xs.map(x -> x * 2)` не должен
// спотыкаться об индекс, который список передаёт вторым.
fn вызвать_колбэк(f, аргументы) {
  if type(f) == "Замыкание" { return вызвать(f, аргументы.slice(0, len(f.параметры))) }
  return вызвать(f, аргументы)
}

fn создать(опред, аргументы) {
  if len(аргументы) > len(опред.поля) {
    ошибка(сообщение_об_арности(опред.имя, len(аргументы), обязательных_полей(опред), len(опред.поля)))
  }
  let поля = {}
  let экземпляр = Экземпляр(опред, поля)
  for i in 0..len(опред.поля) {
    let п = опред.поля[i]
    if i < len(аргументы) {
      set(поля, п.имя, аргументы[i])
    } else if п.поумолчанию != nil {
      // Значение по умолчанию видит уже заполненные поля: `struct P { x, y = x }`.
      let внутри = вложить(опред.среда)
      for имя in keys(поля) { объявить(внутри, имя, get(поля, имя), false) }
      set(поля, п.имя, вычислить(п.поумолчанию, внутри))
    } else {
      ошибка(сообщение_об_арности(опред.имя, len(аргументы), обязательных_полей(опред), len(опред.поля)))
    }
  }
  return экземпляр
}

fn обязательных_полей(опред) {
  let n = 0
  for п in опред.поля {
    if п.поумолчанию == nil { n += 1 }
  }
  return n
}

// ---- инструкции ------------------------------------------------------------

fn выполнить_тело(инструкции, с) {
  for и in инструкции {
    let сиг = выполнить(и, с)
    if сиг != nil { return сиг }
  }
  return nil
}

fn выполнить(и, с) {
  let в = и.вид

  if в == "ExprStmt" {
    вычислить(и.выражение, с)
    return nil
  }
  if в == "VarDecl" {
    объявить(с, и.имя, вычислить(и.инициализатор, с), и.изменяемая)
    return nil
  }
  if в == "FnDecl" {
    объявить(с, и.имя, Замыкание(и.имя, и.параметры, и.тело, с), false)
    return nil
  }
  if в == "StructDecl" {
    объявить(с, и.имя, Опред(и.имя, и.поля, таблица_методов(и.методы), с), false)
    return nil
  }
  if в == "Block" { return выполнить_тело(и.тело, вложить(с)) }
  if в == "If" {
    if истинно(вычислить(и.условие, с)) { return выполнить(и.тогда, с) }
    if и.иначе != nil { return выполнить(и.иначе, с) }
    return nil
  }
  if в == "While" {
    while истинно(вычислить(и.условие, с)) {
      let сиг = выполнить(и.тело, с)
      if сиг != nil {
        if сиг.вид == "break" { break }
        if сиг.вид != "continue" { return сиг }
      }
    }
    return nil
  }
  if в == "For" { return перебрать(и, с) }
  if в == "Return" {
    return Сигнал("return", и.значение == nil ? nil : вычислить(и.значение, с))
  }
  if в == "Break" { return Сигнал("break", nil) }
  if в == "Continue" { return Сигнал("continue", nil) }
  if в == "Try" { return попытка(и, с) }
  if в == "Import" { return подключить(и, с) }

  ошибка("неизвестная инструкция «${в}»")
  return nil
}

fn таблица_методов(методы) {
  let т = {}
  for м in методы { set(т, м.имя, м) }
  return т
}

fn перебрать(и, с) {
  for э in последовательность(вычислить(и.последовательность, с)) {
    let внутри = вложить(с)
    объявить(внутри, и.имя, э, false)
    let сиг = выполнить(и.тело, внутри)
    if сиг != nil {
      if сиг.вид == "break" { break }
      if сиг.вид != "continue" { return сиг }
    }
  }
  return nil
}

// Копия, а не сам список: тело цикла вправе менять исходный прямо во время обхода.
fn последовательность(v) {
  let t = type(v)
  if t == "list" { return v.clone() }
  if t == "string" { return v.chars() }
  if t == "range" {
    let вышло = []
    for э in v { вышло.push(э) }
    return вышло
  }
  // По словарю цикл идёт ключами — так же, как в языке.
  if t == "map" { return keys(v) }
  ошибка("по значению типа ${тип(v)} нельзя пройти циклом for")
  return []
}

fn попытка(и, с) {
  let сиг = nil
  let поймано = nil
  try {
    сиг = выполнить_тело(и.тело, вложить(с))
  } catch e {
    поймано = e
  }

  if поймано != nil && и.обработчик != nil {
    let это = поймано
    поймано = nil
    let внутри = вложить(с)
    if и.параметр != nil { объявить(внутри, и.параметр, ошибкой_значением(это), false) }
    // Ошибка из самого обработчика уходит наружу, но блок finally всё равно
    // обязан отработать — поэтому она ловится здесь, а не улетает сразу.
    try {
      сиг = выполнить_тело(и.обработчик, внутри)
    } catch ещё {
      поймано = ещё
    }
  }

  if и.завершение != nil {
    let свой = выполнить_тело(и.завершение, вложить(с))
    // Сигнал из finally перекрывает то, ради чего покидали блок, — как в языке.
    if свой != nil { return свой }
  }

  if поймано != nil { перебросить(поймано) }
  return сиг
}

// Ошибка уходит выше ровно тем же значением, каким пришла: у поднятой самой
// программой это её значение, у ошибки языка — только текст.
fn перебросить(e) {
  let значение = e.get("value")
  if type(значение) == "Наша" { error(значение) }
  error(e.get("message"))
  return nil
}

// Пойманная ошибка как значение языка: у неё всегда есть message, а value
// хранит то, что передали в error(...).
fn ошибкой_значением(e) {
  let значение = e.get("value")
  let текст = e.get("message")
  if type(значение) == "Наша" {
    текст = значение.текст
    значение = значение.значение
  }
  return {
    "message": текст, "value": значение,
    "file": e.get("file"), "line": e.get("line"), "column": e.get("column"),
  }
}

// ---- выражения -------------------------------------------------------------

fn вычислить(в, с) {
  let вид = в.вид

  if вид == "Number" || вид == "Str" || вид == "Bool" { return в.значение }
  if вид == "Nil" { return nil }
  if вид == "Ident" { return найти(с, в.имя) }

  if вид == "Template" {
    let вышло = ""
    for ч in в.части {
      вышло += ч.has("текст") ? ч.get("текст") : строкой(вычислить(ч.get("выражение"), с))
    }
    return вышло
  }
  if вид == "List" {
    let вышло = []
    for э in в.элементы { вышло.push(вычислить(э, с)) }
    return вышло
  }
  if вид == "Map" {
    let вышло = {}
    for п in в.пары { set(вышло, вычислить(п.ключ, с), вычислить(п.значение, с)) }
    return вышло
  }
  if вид == "Fn" { return Замыкание(в.имя, в.параметры, в.тело, с) }

  if вид == "Unary" {
    let п = вычислить(в.правое, с)
    if в.оп == "!" { return !истинно(п) }
    return -число(п, "операнд унарного минуса")
  }
  if вид == "Logical" { return логическое(в, с) }
  if вид == "Ternary" {
    return истинно(вычислить(в.условие, с)) ? вычислить(в.тогда, с) : вычислить(в.иначе, с)
  }
  if вид == "Binary" { return двуместное(в.оп, вычислить(в.левое, с), вычислить(в.правое, с)) }
  if вид == "Range" {
    let а = число(вычислить(в.начало, с), "начало диапазона")
    let б = число(вычислить(в.конец, с), "конец диапазона")
    return а..б
  }

  if вид == "Get" { return член(вычислить(в.объект, с), в.имя) }
  if вид == "Index" { return по_индексу(вычислить(в.объект, с), вычислить(в.индекс, с)) }
  if вид == "Call" { return вызов(в, с) }
  if вид == "Assign" { return присваивание(в, с) }

  ошибка("неизвестное выражение «${вид}»")
  return nil
}

fn логическое(в, с) {
  let л = вычислить(в.левое, с)
  if в.оп == "??" { return л == nil ? вычислить(в.правое, с) : л }
  // «and» и «or» доживают до дерева как есть: лексер словесные синонимы
  // не переписывает в знаки, а форматтер — уже после разбора.
  if в.оп == "&&" || в.оп == "and" { return истинно(л) ? вычислить(в.правое, с) : л }
  return истинно(л) ? л : вычислить(в.правое, с)
}

fn число(v, что) {
  if type(v) != "number" { ошибка("${что} должен быть числом, а получен ${тип(v)}") }
  return v
}

fn двуместное(оп, л, п) {
  if оп == "==" { return равно(л, п) }
  if оп == "!=" { return !равно(л, п) }

  if type(л) == "number" && type(п) == "number" { return над_числами(оп, л, п) }

  if оп == "+" {
    if type(л) == "string" && type(п) == "string" { return л + п }
    if type(л) == "list" && type(п) == "list" { return л + п }
    if type(л) == "string" || type(п) == "string" {
      ошибка("нельзя сложить ${тип(л)} и ${тип(п)} — приведите к строке через str(...) или вставку \${...}")
    }
    ошибка("нельзя сложить ${тип(л)} и ${тип(п)}")
  }
  if оп == "*" {
    if type(л) == "string" && type(п) == "number" { return л * п }
    if type(л) == "number" && type(п) == "string" { return п * л }
    if type(л) == "list" && type(п) == "number" { return л * п }
  }
  if оп == "<" || оп == "<=" || оп == ">" || оп == ">=" {
    if type(л) == "string" && type(п) == "string" { return сравнить_строки(оп, л, п) }
  }

  число(л, "левый операнд «${оп}»")
  число(п, "правый операнд «${оп}»")
  ошибка("неизвестный оператор «${оп}»")
  return nil
}

fn сравнить_строки(оп, л, п) {
  if оп == "<" { return л < п }
  if оп == "<=" { return л <= п }
  if оп == ">" { return л > п }
  return л >= п
}

// Арифметика отдаётся самому языку: он же и проверит переполнение и деление
// на ноль своими сообщениями, а мы не заведём второй источник правды о том,
// сколько будет 0.1 + 0.2.
fn над_числами(оп, л, п) {
  if оп == "+" { return л + п }
  if оп == "-" { return л - п }
  if оп == "*" { return л * п }
  if оп == "/" { return л / п }
  if оп == "%" { return л % п }
  if оп == "^" { return л ^ п }
  if оп == "<" { return л < п }
  if оп == "<=" { return л <= п }
  if оп == ">" { return л > п }
  if оп == ">=" { return л >= п }
  ошибка("неизвестный оператор «${оп}»")
  return nil
}

// ---- члены и индексы -------------------------------------------------------

fn член(объект, имя) {
  if объект == nil {
    ошибка("нельзя обратиться к «${имя}» у nil — проверьте значение или используйте «??»")
  }
  if type(объект) == "Экземпляр" {
    if has(объект.поля, имя) { return get(объект.поля, имя) }
    if has(объект.опред.методы, имя) { return связать(объект, get(объект.опред.методы, имя)) }
    нет_члена(объект, имя, keys(объект.поля) + keys(объект.опред.методы))
  }
  if type(объект) == "Модуль" {
    if has(объект.среда.значения, имя) { return get(объект.среда.значения, имя) }
    ошибка("в модуле «${объект.псевдоним}» нет имени «${имя}»"
      + подсказка(имя, keys(объект.среда.значения)))

  }
  if type(объект) == "map" {
    if has(объект, имя) { return get(объект, имя) }
    нет_ключа(объект, имя)
  }
  // Метод встроенного типа сам по себе значением не берётся: он существует
  // только в вызове, и туда его отдаёт `вызов`.
  нет_члена(объект, имя, имена_методов(объект))
  return nil
}

// У словаря сначала ищется ключ, потом метод — поэтому и сообщение своё:
// человек чаще ошибается в ключе, а не в имени метода.
fn нет_ключа(словарь, имя) {
  ошибка("в словаре нет ключа «${имя}» и нет такого метода"
    + подсказка(имя, строковые_ключи(словарь) + имена_методов(словарь)))
  return nil
}

fn строковые_ключи(словарь) {
  let вышло = []
  for k in keys(словарь) {
    if type(k) == "string" { вышло.push(k) }
  }
  return вышло
}

// Единственное место, где составляется это сообщение: к полю и к методу ведут
// разные пути, а человек обязан видеть один и тот же текст.
fn нет_члена(объект, имя, известные) {
  let чей = type(объект) == "Экземпляр" ? объект.опред.имя : "значения типа ${тип(объект)}"
  ошибка("у ${чей} нет поля или метода «${имя}»${подсказка(имя, известные)}")
  return nil
}

// Имена методов, какие у этого получателя вообще есть: мост знает их все,
// а какие из них подойдут — покажет сам вызов.
fn имена_методов(объект) {
  let вышло = []
  for имя in keys(мост.МЕТОДЫ) { вышло.push(имя) }
  if type(объект) == "list" {
    for имя in keys(СПИСОЧНЫЕ) { вышло.push(имя) }
  }
  return вышло
}

fn связать(экземпляр, метод) {
  let внутри = вложить(экземпляр.опред.среда)
  объявить(внутри, "self", экземпляр, false)
  return Замыкание(метод.имя, метод.параметры, метод.тело, внутри)
}

fn по_индексу(объект, ключ) {
  let t = type(объект)
  if t == "list" || t == "string" { return объект[ключ] }
  if t == "range" { return объект[ключ] }
  if t == "map" {
    if !has(объект, ключ) { ошибка("в словаре нет ключа ${представление(ключ)}") }
    return get(объект, ключ)
  }
  if t == "Экземпляр" { return член(объект, ключ) }
  ошибка("к значению типа ${тип(объект)} нельзя обратиться по индексу")
  return nil
}

// ---- вызовы в дереве -------------------------------------------------------

fn вызов(в, с) {
  let аргументы = []
  for а in в.аргументы { аргументы.push(вычислить(а, с)) }

  // Вызов метода разбирается здесь, а не через «взять член и позвать»:
  // у встроенных типов методы значением не существуют.
  if в.вызываемое.вид == "Get" {
    let объект = вычислить(в.вызываемое.объект, с)
    return вызов_метода(объект, в.вызываемое.имя, аргументы)
  }
  return вызвать(вычислить(в.вызываемое, с), аргументы)
}

fn вызов_метода(объект, имя, аргументы) {
  if объект == nil {
    ошибка("нельзя обратиться к «${имя}» у nil — проверьте значение или используйте «??»")
  }
  if type(объект) == "Экземпляр" {
    if has(объект.опред.методы, имя) {
      return вызвать(связать(объект, get(объект.опред.методы, имя)), аргументы)
    }
    if has(объект.поля, имя) { return вызвать(get(объект.поля, имя), аргументы) }
    нет_члена(объект, имя, keys(объект.поля) + keys(объект.опред.методы))
  }
  if type(объект) == "Модуль" { return вызвать(член(объект, имя), аргументы) }

  // Методы, принимающие функцию, — своей работой: настоящий метод не умеет
  // звать наше замыкание.
  // Своей работой — только когда первым аргументом и правда дали функцию.
  // Иначе пусть отвечает настоящий метод: и про число аргументов, и про то,
  // что функции он не дождался, он скажет своими словами.
  let своей = len(аргументы) > 0 && вызываемое(аргументы[0])
  if своей && type(объект) == "list" && has(СПИСОЧНЫЕ, имя) {
    return get(СПИСОЧНЫЕ, имя)(объект, аргументы)
  }
  if type(объект) == "map" {
    if своей && has(СЛОВАРНЫЕ, имя) { return get(СЛОВАРНЫЕ, имя)(объект, аргументы) }
    // Значение под таким ключом важнее одноимённого метода — так же в языке.
    if has(объект, имя) { return вызвать(get(объект, имя), аргументы) }
    if !has(мост.МЕТОДЫ, имя) { нет_ключа(объект, имя) }
  }

  if has(мост.МЕТОДЫ, имя) { return get(мост.МЕТОДЫ, имя)(объект, аргументы) }
  нет_члена(объект, имя, имена_методов(объект))
  return nil
}

// ---- присваивание ----------------------------------------------------------

fn присваивание(в, с) {
  let цель = в.цель

  if цель.вид == "Ident" {
    let значение = вычислить(в.значение, с)
    if в.оп != nil { значение = двуместное(в.оп, найти(с, цель.имя), значение) }
    return присвоить(с, цель.имя, значение)
  }

  if цель.вид == "Get" {
    // Объект вычисляется один раз: `f().поле += 1` не должен звать f дважды.
    let объект = вычислить(цель.объект, с)
    let значение = вычислить(в.значение, с)
    if в.оп != nil { значение = двуместное(в.оп, член(объект, цель.имя), значение) }
    return записать_член(объект, цель.имя, значение)
  }

  let объект = вычислить(цель.объект, с)
  let ключ = вычислить(цель.индекс, с)
  let значение = вычислить(в.значение, с)
  if в.оп != nil { значение = двуместное(в.оп, по_индексу(объект, ключ), значение) }
  return записать_по_индексу(объект, ключ, значение)
}

fn записать_член(объект, имя, значение) {
  if type(объект) == "Экземпляр" {
    if !has(объект.поля, имя) { ошибка("у ${объект.опред.имя} нет поля «${имя}»") }
    set(объект.поля, имя, значение)
    return значение
  }
  if type(объект) == "map" {
    set(объект, имя, значение)
    return значение
  }
  ошибка("значению типа ${тип(объект)} нельзя присвоить член «${имя}»")
  return nil
}

fn записать_по_индексу(объект, ключ, значение) {
  let t = type(объект)
  if t == "list" {
    объект[ключ] = значение
    return значение
  }
  if t == "map" {
    set(объект, ключ, значение)
    return значение
  }
  if t == "Экземпляр" { return записать_член(объект, ключ, значение) }
  ошибка("значению типа ${тип(объект)} нельзя присвоить по индексу")
  return nil
}

// ---- методы, принимающие функцию -------------------------------------------
//
// Эти методы нельзя просто позвать через мост: они зовут переданную функцию,
// а функция выполняемой программы — наше замыкание, о котором язык-хозяин
// ничего не знает. Поэтому в настоящий метод отдаётся наша лямбда-переходник,
// и уже она зовёт замыкание. Сам обход, сортировка и группировка остаются
// настоящими — переписывать их значило бы разойтись в мелочах.

fn вызываемое(v) {
  let t = type(v)
  return t == "Замыкание" || t == "fn" || t == "Опред" || t == "Своя"
}

const СПИСОЧНЫЕ = {
  "map": (п, а) -> п.map((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "filter": (п, а) -> п.filter((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "find": (п, а) -> п.find((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "find_index": (п, а) -> п.find_index((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "any": (п, а) -> п.any((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "all": (п, а) -> п.all((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "reduce": (п, а) -> п.reduce((н, x, i) -> вызвать_колбэк(а[0], [н, x, i]), а[1]),
  "sort_by": (п, а) -> п.sort_by((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "min_by": (п, а) -> п.min_by((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "max_by": (п, а) -> п.max_by((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "group_by": (п, а) -> п.group_by((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "sum_by": (п, а) -> п.sum_by((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "partition": (п, а) -> п.partition((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "flat_map": (п, а) -> п.flat_map((x, i) -> вызвать_колбэк(а[0], [x, i])),
  "sort": (п, а) -> п.sort((x, y) -> вызвать_колбэк(а[0], [x, y])),
  "count": (п, а) -> п.count((x, i) -> вызвать_колбэк(а[0], [x, i])),
}

const СЛОВАРНЫЕ = {
  "map_values": (п, а) -> п.map_values((v, k) -> вызвать_колбэк(а[0], [v, k])),
  "filter": (п, а) -> п.filter((v, k) -> вызвать_колбэк(а[0], [v, k])),
}

// ---- встроенные, которые нельзя отдать мосту -------------------------------
//
// Печать, сравнение и вызов обязаны понимать наши структуры, а мост о них не
// знает. Такие встроенные подменяются меткой: `вызвать` узнаёт её по типу и
// зовёт нашу работу. Метка нужна ещё и потому, что у print и write число
// аргументов не ограничено, а у функции языка оно всегда определённое.

struct Своя {
  имя
}

const ПОДМЕНЁННЫЕ = [
  "print", "write", "str", "repr", "type", "error", "assert", "apply",
  "map", "filter", "reduce", "sorted", "to_json",
]

fn своя(имя, а) {
  if имя == "print" { return печатать(а, "\n") }
  if имя == "write" { return печатать(а, "") }
  if имя == "str" { return строкой(один(имя, а)) }
  if имя == "repr" { return представление(один(имя, а)) }
  if имя == "type" { return тип(один(имя, а)) }
  if имя == "error" { return поднять(один(имя, а)) }
  if имя == "apply" {
    if !вызываемое(а[0]) {
      ошибка("«apply» ожидает функцию первым аргументом, а получила ${тип(а[0])}")
    }
    if type(а[1]) != "list" {
      ошибка("«apply» ожидает список аргументов вторым аргументом, а получила ${тип(а[1])}")
    }
    return вызвать(а[0], а[1].clone())
  }

  if имя == "assert" {
    if истинно(а[0]) { return nil }
    ошибка("assert: ${len(а) > 1 ? строкой(а[1]) : "проверка не прошла"}")
  }
  if имя == "map" { return последовательность(а[0]).map((x, i) -> вызвать_колбэк(а[1], [x, i])) }
  if имя == "filter" { return последовательность(а[0]).filter((x, i) -> вызвать_колбэк(а[1], [x, i])) }
  if имя == "reduce" {
    return последовательность(а[0]).reduce((н, x, i) -> вызвать_колбэк(а[1], [н, x, i]), а[2])
  }
  if имя == "sorted" {
    // Без сравнения — настоящей sorted: её отказ на разнородном списке назван
    // её именем, и подменять его именем метода нельзя.
    if len(а) < 2 { return get(мост.ФУНКЦИИ, "sorted")(а[0]) }
    return последовательность(а[0]).sort((x, y) -> вызвать_колбэк(а[1], [x, y]))
  }
  if имя == "to_json" {
    return len(а) < 2 ? to_json(простым(а[0])) : to_json(простым(а[0]), а[1])
  }

  ошибка("встроенная «${имя}» не подменена, а должна быть")
  return nil
}

fn один(имя, а) {
  if len(а) != 1 { ошибка(сообщение_об_арности(имя, len(а), 1, 1)) }
  return а[0]
}

fn печатать(а, хвост) {
  let части = []
  for v in а { части.push(строкой(v)) }
  write(части.join(" ") + хвост)
  return nil
}

// Экземпляр структуры в JSON уходит словарём своих полей — так же, как
// в настоящем языке.
fn простым(v) {
  let t = type(v)
  if t == "Экземпляр" {
    let вышло = {}
    for k in keys(v.поля) { set(вышло, k, простым(get(v.поля, k))) }
    return вышло
  }
  if t == "list" {
    let вышло = []
    for э in v { вышло.push(простым(э)) }
    return вышло
  }
  if t == "map" {
    let вышло = {}
    for k in keys(v) { set(вышло, k, простым(get(v, k))) }
    return вышло
  }
  return v
}

// ---- корневая область ------------------------------------------------------
//
// Встроенные лежат в отдельной области-родителе, а не вперемешку с именами
// программы: тогда `let sum = 0` затеняет встроенную sum, а не спорит с ней.

fn корень() {
  let с = Среда({}, {}, nil)
  for имя in keys(мост.ФУНКЦИИ) { set(с.значения, имя, get(мост.ФУНКЦИИ, имя)) }
  for имя in ПОДМЕНЁННЫЕ { set(с.значения, имя, Своя(имя)) }
  return с
}

// ---- модули ----------------------------------------------------------------

fn каталог(путь) {
  let i = путь.index_of("/")
  if i < 0 { return "" }
  let последний = -1
  for j in 0..len(путь) {
    if путь[j] == "/" { последний = j }
  }
  return путь.slice(0, последний + 1)
}

fn подключить(и, с) {
  let полный = каталог(ФАЙЛ.get("путь")) + и.путь
  let модуль = загрузить(полный, и.псевдоним == nil ? и.путь : и.псевдоним, и.путь)

  if и.имена == nil {
    объявить(с, и.псевдоним, модуль, false)
    return nil
  }
  for н in и.имена {
    if !has(модуль.среда.значения, н.имя) {
      ошибка("в модуле «${и.путь}» нет имени «${н.имя}»"
        + подсказка(н.имя, keys(модуль.среда.значения)))
    }
    объявить(с, н.псевдоним, get(модуль.среда.значения, н.имя), false)
  }
  return nil
}

// Модуль выполняется один раз на путь: повторный import отдаёт то же самое,
// иначе два подключения одного файла завели бы две копии его состояния.
const ЗАГРУЖЕННЫЕ = {}
const ФАЙЛ = {"путь": ""}

fn загрузить(путь, псевдоним, сырой) {
  if has(ЗАГРУЖЕННЫЕ, путь) { return get(ЗАГРУЖЕННЫЕ, путь) }

  let текст = ""
  try {
    текст = read_file(путь)
  } catch {
    ошибка("не удалось прочитать модуль «${сырой}» — искали по пути ${путь}")
  }
  let среда = вложить(КОРЕНЬ)
  let модуль = Модуль(псевдоним, путь, среда)
  set(ЗАГРУЖЕННЫЕ, путь, модуль)

  let было = ФАЙЛ.get("путь")
  ФАЙЛ.set("путь", путь)
  выполнить_тело(парсер.разобрать(текст), среда)
  ФАЙЛ.set("путь", было)
  return модуль
}

// ---- вход ------------------------------------------------------------------

const КОРЕНЬ = корень()

fn выполнить_файл(путь) {
  ФАЙЛ.set("путь", путь)
  let среда = вложить(КОРЕНЬ)
  сорвался(выполнить_тело(парсер.разобрать(read_file(путь)), среда))
  return nil
}

// Сигнал, дошедший до верха программы, — ошибка исходника: return вне функции,
// break из функции наружу.
fn сорвался(сиг) {
  if сиг == nil { return nil }
  if сиг.вид == "return" { ошибка("«return» вне функции") }
  ошибка("«${сиг.вид}» вне цикла — из функции нельзя прервать цикл, который её вызвал")
  return nil
}

// Между программами кэш модулей чистится: иначе вторая программа увидела бы
// состояние, оставшееся от первой, и разошлась бы с отдельным запуском.
// Текст ошибки так, как его показал бы язык: у поднятой самой программой он
// свой, а не пересказ нашей обёртки.
fn текст_ошибки(e) {
  let значение = get(e, "value")
  if type(значение) == "Наша" { return значение.текст }
  return get(e, "message")
}

fn забыть_модули() {
  for путь in keys(ЗАГРУЖЕННЫЕ) { remove(ЗАГРУЖЕННЫЕ, путь) }
  return nil
}
