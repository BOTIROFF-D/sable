// Каноническая запись дерева — та же, что печатает tests/ast-repr.ts для
// настоящего парсера. Одна строка на узел, два пробела на уровень вложенности,
// голова и её атомы через пробел, дети — следующими строками глубже.
//
// Позиции сюда не попадают: сверять их бессмысленно, а на разбор они не влияют.

// Экранирование ровно в этом порядке: косая первой, иначе она удвоила бы
// собственные вставки. Ничего сверх этих пяти замен — кавычки должны выходить
// одинаковыми на обеих сторонах, а не «как принято в JSON».
fn кавычки(текст) {
  let t = текст.replace("\\", "\\\\")
  t = t.replace("\"", "\\\"")
  t = t.replace("\n", "\\n")
  t = t.replace("\t", "\\t")
  t = t.replace("\r", "\\r")
  return "\"" + t + "\""
}

struct Лист { строки = [] }

fn строку(л, глубина, текст) {
  л.строки.push("  ".repeat(глубина) + текст)
  return nil
}

fn имя_или_прочерк(имя) { return имя == nil ? "-" : имя }

// ---- инструкции ------------------------------------------------------------

fn инструкцию(л, у, г) {
  if у.вид == "VarDecl" {
    строку(л, г, "VarDecl ${у.изменяемая ? "let" : "const"} ${у.имя}")
    выражение(л, у.инициализатор, г + 1)
    return nil
  }
  if у.вид == "FnDecl" {
    строку(л, г, "FnDecl ${у.имя}")
    параметры(л, "Params", у.параметры, г + 1)
    тело(л, "Body", у.тело, г + 1)
    return nil
  }
  if у.вид == "StructDecl" {
    строку(л, г, "StructDecl ${у.имя}")
    параметры(л, "Fields", у.поля, г + 1)
    // Обёртка Methods печатается всегда, даже пустая: иначе структура без
    // методов и структура без полей давали бы одинаковую запись.
    строку(л, г + 1, "Methods")
    for м in у.методы {
      строку(л, г + 2, "Method ${м.имя}")
      параметры(л, "Params", м.параметры, г + 3)
      тело(л, "Body", м.тело, г + 3)
    }
    return nil
  }
  if у.вид == "Import" {
    строку(л, г, "Import ${кавычки(у.путь)}")
    if у.имена == nil {
      строку(л, г + 1, "Alias ${у.псевдоним}")
    } else {
      строку(л, г + 1, "Names")
      for и in у.имена { строку(л, г + 2, "Name ${и.имя} ${и.псевдоним}") }
    }
    return nil
  }
  if у.вид == "ExprStmt" {
    строку(л, г, "ExprStmt")
    выражение(л, у.выражение, г + 1)
    return nil
  }
  if у.вид == "Block" {
    строку(л, г, "Block")
    for и in у.тело { инструкцию(л, и, г + 1) }
    return nil
  }
  if у.вид == "If" {
    строку(л, г, "If")
    выражение(л, у.условие, г + 1)
    инструкцию(л, у.тогда, г + 1)
    if у.иначе != nil { инструкцию(л, у.иначе, г + 1) }
    return nil
  }
  if у.вид == "While" {
    строку(л, г, "While")
    выражение(л, у.условие, г + 1)
    инструкцию(л, у.тело, г + 1)
    return nil
  }
  if у.вид == "For" {
    строку(л, г, "For ${у.имя}")
    выражение(л, у.последовательность, г + 1)
    инструкцию(л, у.тело, г + 1)
    return nil
  }
  if у.вид == "Try" {
    строку(л, г, "Try")
    тело(л, "Body", у.тело, г + 1)
    if у.обработчик != nil { тело(л, "Catch ${имя_или_прочерк(у.параметр)}", у.обработчик, г + 1) }
    if у.завершение != nil { тело(л, "Finally", у.завершение, г + 1) }
    return nil
  }
  if у.вид == "Return" {
    строку(л, г, "Return")
    if у.значение != nil { выражение(л, у.значение, г + 1) }
    return nil
  }
  строку(л, г, у.вид)
  return nil
}

fn тело(л, голова, инструкции, г) {
  строку(л, г, голова)
  for и in инструкции { инструкцию(л, и, г + 1) }
  return nil
}

fn параметры(л, голова, список, г) {
  строку(л, г, голова)
  for п in список {
    строку(л, г + 1, "Param ${п.имя}")
    if п.поумолчанию != nil { выражение(л, п.поумолчанию, г + 2) }
  }
  return nil
}

// ---- выражения -------------------------------------------------------------

fn выражение(л, у, г) {
  if у.вид == "Number" { return строку(л, г, "Number ${str(у.значение)}") }
  if у.вид == "Str" { return строку(л, г, "Str ${кавычки(у.значение)}") }
  if у.вид == "Bool" { return строку(л, г, "Bool ${у.значение ? "true" : "false"}") }
  if у.вид == "Nil" { return строку(л, г, "Nil") }
  if у.вид == "Ident" { return строку(л, г, "Ident ${у.имя}") }

  if у.вид == "Template" {
    строку(л, г, "Template")
    for ч in у.части {
      if ч.has("текст") {
        строку(л, г + 1, "Text ${кавычки(ч.get("текст"))}")
      } else {
        выражение(л, ч.get("выражение"), г + 1)
      }
    }
    return nil
  }
  if у.вид == "List" {
    строку(л, г, "List")
    for э in у.элементы { выражение(л, э, г + 1) }
    return nil
  }
  if у.вид == "Map" {
    строку(л, г, "Map")
    for п in у.пары {
      строку(л, г + 1, "Entry")
      выражение(л, п.ключ, г + 2)
      выражение(л, п.значение, г + 2)
    }
    return nil
  }
  if у.вид == "Unary" {
    строку(л, г, "Unary ${у.оп}")
    выражение(л, у.правое, г + 1)
    return nil
  }
  if у.вид == "Binary" || у.вид == "Logical" {
    строку(л, г, "${у.вид} ${у.оп}")
    выражение(л, у.левое, г + 1)
    выражение(л, у.правое, г + 1)
    return nil
  }
  if у.вид == "Ternary" {
    строку(л, г, "Ternary")
    выражение(л, у.условие, г + 1)
    выражение(л, у.тогда, г + 1)
    выражение(л, у.иначе, г + 1)
    return nil
  }
  if у.вид == "Range" {
    строку(л, г, "Range")
    выражение(л, у.начало, г + 1)
    выражение(л, у.конец, г + 1)
    return nil
  }
  if у.вид == "Call" {
    строку(л, г, "Call")
    выражение(л, у.вызываемое, г + 1)
    for а in у.аргументы { выражение(л, а, г + 1) }
    return nil
  }
  if у.вид == "Get" {
    строку(л, г, "Get ${у.имя}")
    выражение(л, у.объект, г + 1)
    return nil
  }
  if у.вид == "Index" {
    строку(л, г, "Index")
    выражение(л, у.объект, г + 1)
    выражение(л, у.индекс, г + 1)
    return nil
  }
  if у.вид == "Assign" {
    строку(л, г, "Assign ${у.оп == nil ? "=" : у.оп}")
    выражение(л, у.цель, г + 1)
    выражение(л, у.значение, г + 1)
    return nil
  }
  if у.вид == "Fn" {
    строку(л, г, "Fn ${имя_или_прочерк(у.имя)}")
    параметры(л, "Params", у.параметры, г + 1)
    тело(л, "Body", у.тело, г + 1)
    return nil
  }
  error("неизвестный вид узла «${у.вид}»")
  return nil
}

// ---- вход ------------------------------------------------------------------

fn канон(программа) {
  let л = Лист()
  строку(л, 0, "Program")
  for и in программа { инструкцию(л, и, 1) }
  return л.строки.join("\n")
}
