// Печатает дерево разбора для каждого файла, переданного в командной строке.
// Заголовок «=== путь», затем каноническая запись; на нерабочем файле — «!!! отказ».

import "parser.sable" as парсер
import "запись.sable" as запись

for путь in args() {
  print("=== " + путь)
  try {
    print(запись.канон(парсер.разобрать(read_file(путь))))
  } catch {
    print("!!! отказ")
  }
}
