// Выполняет каждую программу, путь к которой передан в командной строке,
// интерпретатором, написанным на Sable.
//
// Границы размечаются управляющими символами, а не строками вида «=== путь»:
// вывод программы может кончиться без перевода строки или сам содержать что
// угодно, и по строкам его потом не разрезать без догадок.
//   \u{0001} путь \u{0002} вывод [ \u{0003} сообщение об ошибке ]
//
// Ошибка выполнения — тоже результат: она не обрывает остальные программы.

import "интерпретатор.sable" as и

for путь in args() {
  write(char(1) + путь + char(2))
  и.забыть_модули()
  try {
    и.выполнить_файл(путь)
  } catch e {
    write(char(3) + и.текст_ошибки(e))
  }
}
