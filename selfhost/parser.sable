// Парсер Sable, написанный на Sable.
//
// Рекурсивный спуск по лексемам из lexer.sable. Повторяет src/parser.ts узел
// в узел: то же дерево, те же приоритеты, те же места, где разбор отказывает.
// Проверяется сверкой — tests/selfhost.ts гоняет оба парсера по каждому файлу
// репозитория и требует совпадения деревьев до буквы.
//
// Позиции в дерево не кладутся вовсе: сверять их бессмысленно (настоящий лексер
// считает колонки в единицах UTF-16, а Sable — в символах), а на разбор они не
// влияют. Сообщения об ошибках поэтому называют строку, а не колонку.

import "lexer.sable" as лексер

// Глубже этого разбирать нельзя: рекурсия спуска съест стек раньше, чем язык
// успеет сказать об этом внятно. Столько же в настоящем парсере.
const ПРЕДЕЛ_ВЛОЖЕННОСТИ = 150

// Составные присваивания хранят сам оператор, а не разворачиваются в «a = a + v»:
// при развороте цель попадала бы в дерево дважды и вычислялась дважды.
const СОСТАВНЫЕ = {PLUS_ASSIGN: "+", MINUS_ASSIGN: "-", STAR_ASSIGN: "*", SLASH_ASSIGN: "/"}

struct Разбор {
  лексемы
  поз = 0
  // Пока > 0, «{» после выражения читается как тело блока, а не как словарь.
  без_словаря = 0
  // Глубина блоков: import разрешён только на верхнем уровне файла.
  глубина_блоков = 0
  // Глубина спуска — страховка от срыва стека на «[[[[…]]]]».
  глубина = 0
}

// ---- поток лексем ----------------------------------------------------------

fn смотреть(р, сдвиг) {
  let i = min(р.поз + сдвиг, len(р.лексемы) - 1)
  return р.лексемы[i]
}

fn текущая(р) { return смотреть(р, 0) }

fn предыдущая(р) { return р.лексемы[max(0, р.поз - 1)] }

fn конец(р) { return текущая(р).вид == "EOF" }

fn это(р, вид) { return текущая(р).вид == вид }

fn взять(р) {
  if !конец(р) { р.поз += 1 }
  return предыдущая(р)
}

fn совпало(р, виды) {
  for в in виды {
    if это(р, в) {
      взять(р)
      return true
    }
  }
  return false
}

fn отказ(р, что) {
  error("ожидалось ${что}, а встретилось «${текущая(р).текст}» в строке ${текущая(р).строка}")
}

fn ожидать(р, вид, что) {
  if это(р, вид) { return взять(р) }
  отказ(р, что)
  return nil
}

fn пропустить_разделители(р) {
  while это(р, "NEWLINE") || это(р, "SEMI") { взять(р) }
}

fn конец_инструкции(р) {
  if совпало(р, ["NEWLINE", "SEMI"]) {
    пропустить_разделители(р)
    return nil
  }
  if это(р, "RBRACE") || конец(р) { return nil }
  отказ(р, "перенос строки или «;» после инструкции")
  return nil
}

// «}» и следующее за ним слово на разных строках — обычное оформление, и
// перенос между ними разделителем не считается. Слова нет — откатываемся, и
// перенос снова закрывает инструкцию.
fn заглянуть_за_переносы(р, вид) {
  let метка = р.поз
  пропустить_разделители(р)
  if это(р, вид) { return true }
  р.поз = метка
  return false
}

// ---- узлы ------------------------------------------------------------------

fn узел(вид) { return {вид: вид} }

fn параметр(имя, поумолчанию) { return {имя: имя, поумолчанию: поумолчанию} }

// ---- программа -------------------------------------------------------------

fn разобрать(исходник) {
  let р = Разбор(лексер.разобрать(исходник))
  let инструкции = []
  пропустить_разделители(р)
  while !конец(р) {
    инструкции.push(объявление(р))
    пропустить_разделители(р)
  }
  return инструкции
}

// Отдельный разбор исходника вставки ${...}: своя лексема, своё дерево.
fn подвыражение(исходник) {
  let р = Разбор(лексер.разобрать(исходник))
  пропустить_разделители(р)
  let e = выражение(р)
  пропустить_разделители(р)
  if !конец(р) { отказ(р, "конец вставки") }
  return e
}

fn объявление(р) {
  if это(р, "IMPORT") { return импорт(р) }
  if это(р, "LET") || это(р, "CONST") { return объявление_переменной(р) }
  if это(р, "FN") && смотреть(р, 1).вид == "IDENT" { return объявление_функции(р) }
  if это(р, "STRUCT") { return объявление_структуры(р) }
  return инструкция(р)
}

// ---- объявления ------------------------------------------------------------

fn импорт(р) {
  взять(р)
  if р.глубина_блоков > 0 {
    error("import разрешён только на верхнем уровне файла — перенесите его в начало")
  }
  let путь = ожидать(р, "STRING", "путь к файлу в кавычках")
  if путь.части != nil { error("путь к модулю не может содержать вставку") }
  ожидать(р, "AS", "«as» и имя модуля или список имён")

  // «{» сразу после «as» — выборочный импорт. Со словарём это не спорит:
  // после «as» выражения не бывает, читать «{» иначе просто нечем.
  if это(р, "LBRACE") {
    let имена = имена_импорта(р)
    конец_инструкции(р)
    let у = узел("Import")
    у.путь = путь.текст
    у.псевдоним = nil
    у.имена = имена
    return у
  }

  let псевдоним = ожидать(
    р,
    "IDENT",
    "имя, под которым будет доступен модуль, или «{» и список имён",
  )
  конец_инструкции(р)
  let у = узел("Import")
  у.путь = путь.текст
  у.псевдоним = псевдоним.текст
  у.имена = nil
  return у
}

fn имена_импорта(р) {
  взять(р)
  let имена = []
  let занято = {}

  пропустить_разделители(р)
  while !это(р, "RBRACE") && !конец(р) {
    let источник = ожидать(р, "IDENT", "имя из модуля")
    let имя = источник.текст
    let псевдоним = имя
    if совпало(р, ["AS"]) { псевдоним = ожидать(р, "IDENT", "новое имя после «as»").текст }
    // Одно и то же имя дважды в одном списке — опечатка, а не намерение.
    if занято.has(псевдоним) { error("имя «${псевдоним}» указано в списке дважды") }
    занято.set(псевдоним, true)
    имена.push({имя: имя, псевдоним: псевдоним})
    пропустить_разделители(р)
    if !совпало(р, ["COMMA"]) { break }
    пропустить_разделители(р)
  }
  пропустить_разделители(р)
  ожидать(р, "RBRACE", "«}» в конце списка имён")

  if len(имена) == 0 {
    error("список имён пуст — перечислите, что взять из модуля, или подключите его целиком")
  }
  return имена
}

fn объявление_переменной(р) {
  let слово = взять(р)
  let имя = ожидать(р, "IDENT", "имя переменной")
  ожидать(р, "ASSIGN", "«=» и начальное значение")
  let начальное = выражение(р)
  конец_инструкции(р)
  let у = узел("VarDecl")
  у.изменяемая = слово.вид == "LET"
  у.имя = имя.текст
  у.инициализатор = начальное
  return у
}

fn объявление_функции(р) {
  взять(р)
  let имя = ожидать(р, "IDENT", "имя функции")
  let у = узел("FnDecl")
  у.имя = имя.текст
  у.параметры = параметры(р)
  у.тело = блок(р)
  return у
}

fn объявление_структуры(р) {
  взять(р)
  let имя = ожидать(р, "IDENT", "имя структуры")
  ожидать(р, "LBRACE", "«{» и описание полей")
  пропустить_разделители(р)

  let поля = []
  let методы = []
  // Повтор имени в структуре молча терял значение: «struct P { x, x }»
  // требовал два аргумента, а поле оставалось одно.
  let занято = {}

  while !это(р, "RBRACE") && !конец(р) {
    if это(р, "FN") {
      взять(р)
      let имя_метода = ожидать(р, "IDENT", "имя метода").текст
      занять(занято, имя_метода, "метод")
      методы.push({имя: имя_метода, параметры: параметры(р), тело: блок(р)})
    } else {
      let поле = ожидать(р, "IDENT", "имя поля или «fn» для метода").текст
      занять(занято, поле, "поле")
      let поумолчанию = совпало(р, ["ASSIGN"]) ? выражение(р) : nil
      поля.push(параметр(поле, поумолчанию))
    }
    пропустить_разделители(р)
    совпало(р, ["COMMA"])
    пропустить_разделители(р)
  }

  ожидать(р, "RBRACE", "«}» в конце структуры")
  let у = узел("StructDecl")
  у.имя = имя.текст
  у.поля = поля
  у.методы = методы
  return у
}

fn занять(занято, имя, что) {
  if занято.has(имя) { error("«${имя}» в структуре уже объявлено как ${занято.get(имя)}") }
  занято.set(имя, что)
  return nil
}

fn параметры(р) {
  ожидать(р, "LPAREN", "«(» и список параметров")
  let список = []
  let занято = {}
  while !это(р, "RPAREN") && !конец(р) {
    let имя = ожидать(р, "IDENT", "имя параметра").текст
    if занято.has(имя) { error("параметр «${имя}» указан дважды") }
    занято.set(имя, true)
    let поумолчанию = совпало(р, ["ASSIGN"]) ? выражение(р) : nil
    if поумолчанию == nil && len(список) > 0 && список.last().поумолчанию != nil {
      error(
        "параметр «${имя}» без значения по умолчанию не может идти после параметра со значением",
      )
    }
    список.push(параметр(имя, поумолчанию))
    if !совпало(р, ["COMMA"]) { break }
  }
  ожидать(р, "RPAREN", "«)» в конце списка параметров")
  return список
}

fn блок(р) {
  ожидать(р, "LBRACE", "«{» и тело блока")
  р.глубина += 1
  if р.глубина > ПРЕДЕЛ_ВЛОЖЕННОСТИ {
    error("блоки вложены глубже ${ПРЕДЕЛ_ВЛОЖЕННОСТИ} уровней — такую вложенность разобрать нельзя")
  }
  let тело = []
  р.глубина_блоков += 1
  пропустить_разделители(р)
  while !это(р, "RBRACE") && !конец(р) {
    тело.push(объявление(р))
    пропустить_разделители(р)
  }
  р.глубина_блоков -= 1
  р.глубина -= 1
  ожидать(р, "RBRACE", "«}» в конце блока")
  return тело
}

// Тело if/while/for всегда оборачивается в Block — так же, как в настоящем
// парсере, иначе в дереве не хватало бы уровня.
fn блок_узлом(р) {
  let у = узел("Block")
  у.тело = блок(р)
  return у
}

// ---- инструкции ------------------------------------------------------------

fn инструкция(р) {
  if это(р, "LBRACE") { return блок_узлом(р) }
  if это(р, "IF") { return условная(р) }
  if это(р, "WHILE") { return пока(р) }
  if это(р, "FOR") { return перебор(р) }
  if это(р, "TRY") { return попытка(р) }
  // Сам по себе «finally» инструкцией не бывает: без try ему нечего доводить
  // до конца. Без этой ветки он дошёл бы до разбора выражения и получил
  // невнятное «ожидалось значение».
  if это(р, "FINALLY") {
    error("«finally» без try — этот блок пишется сразу после тела try или после его «catch»")
  }
  if это(р, "RETURN") { return возврат(р) }
  if это(р, "BREAK") {
    взять(р)
    конец_инструкции(р)
    return узел("Break")
  }
  if это(р, "CONTINUE") {
    взять(р)
    конец_инструкции(р)
    return узел("Continue")
  }

  let у = узел("ExprStmt")
  у.выражение = выражение(р)
  конец_инструкции(р)
  return у
}

// Условие цикла и ветвления: «{» здесь всегда начало тела.
fn условие(р) {
  р.без_словаря += 1
  let e = выражение(р)
  р.без_словаря -= 1
  return e
}

fn условная(р) {
  взять(р)
  let у = узел("If")
  у.условие = условие(р)
  у.тогда = блок_узлом(р)
  у.иначе = nil
  if заглянуть_за_переносы(р, "ELSE") {
    взять(р)
    у.иначе = это(р, "IF") ? условная(р) : блок_узлом(р)
  }
  return у
}

fn пока(р) {
  взять(р)
  let у = узел("While")
  у.условие = условие(р)
  у.тело = блок_узлом(р)
  return у
}

fn перебор(р) {
  взять(р)
  let имя = ожидать(р, "IDENT", "имя переменной цикла")
  ожидать(р, "IN", "«in» и последовательность")
  let у = узел("For")
  у.имя = имя.текст
  у.последовательность = условие(р)
  у.тело = блок_узлом(р)
  return у
}

fn попытка(р) {
  взять(р)
  let тело = блок(р)

  let параметр_ошибки = nil
  let обработчик = nil
  if заглянуть_за_переносы(р, "CATCH") {
    взять(р)
    if это(р, "IDENT") { параметр_ошибки = взять(р).текст }
    обработчик = блок(р)
  }

  let завершение = nil
  if заглянуть_за_переносы(р, "FINALLY") {
    взять(р)
    завершение = блок(р)
    // Второй finally: какой из них «всегда выполняется» — вопрос без ответа.
    if заглянуть_за_переносы(р, "FINALLY") {
      error("у try уже есть «finally» — второго быть не может")
    }
  }

  if обработчик == nil && завершение == nil {
    error(
      "после блока try обязателен «catch» или «finally» — сам по себе try ошибку не обрабатывает",
    )
  }

  let у = узел("Try")
  у.тело = тело
  у.параметр = параметр_ошибки
  у.обработчик = обработчик
  у.завершение = завершение
  return у
}

fn возврат(р) {
  взять(р)
  let у = узел("Return")
  у.значение = nil
  if !это(р, "NEWLINE") && !это(р, "SEMI") && !это(р, "RBRACE") && !конец(р) {
    у.значение = выражение(р)
  }
  конец_инструкции(р)
  return у
}

// ---- выражения -------------------------------------------------------------

fn выражение(р) {
  р.глубина += 1
  if р.глубина > ПРЕДЕЛ_ВЛОЖЕННОСТИ {
    error(
      "выражение вложено глубже ${ПРЕДЕЛ_ВЛОЖЕННОСТИ} уровней — такую вложенность разобрать нельзя",
    )
  }
  let e = присваивание(р)
  р.глубина -= 1
  return e
}

fn присваивание(р) {
  // Короткая лямбда одного аргумента: «x -> x * 2».
  if это(р, "IDENT") && смотреть(р, 1).вид == "ARROW" {
    let имя = взять(р).текст
    взять(р)
    return лямбда([параметр(имя, nil)], присваивание(р))
  }

  let цель = тернарное(р)
  let оп = текущая(р)

  if оп.вид == "ASSIGN" || СОСТАВНЫЕ.has(оп.вид) {
    взять(р)
    if цель.вид != "Ident" && цель.вид != "Get" && цель.вид != "Index" {
      error("присваивать можно только переменной, полю или элементу")
    }
    let у = узел("Assign")
    у.оп = СОСТАВНЫЕ.get(оп.вид, nil)
    у.цель = цель
    у.значение = присваивание(р)
    return у
  }

  return цель
}

fn лямбда(параметры_списком, тело_выражением) {
  let возврат_узел = узел("Return")
  возврат_узел.значение = тело_выражением
  let у = узел("Fn")
  у.имя = nil
  у.параметры = параметры_списком
  у.тело = [возврат_узел]
  return у
}

// «условие ? одно : другое» — правоассоциативно, слабее «??».
fn тернарное(р) {
  let усл = слияние(р)
  if !это(р, "QUESTION") { return усл }
  взять(р)
  let тогда = тернарное(р)
  ожидать(р, "COLON", "«:» и вторую ветку тернарного оператора")
  let у = узел("Ternary")
  у.условие = усл
  у.тогда = тогда
  у.иначе = тернарное(р)
  return у
}

fn уровень(р, дальше, вид_узла, виды) {
  let левое = дальше(р)
  while содержит(виды, текущая(р).вид) {
    let оп = взять(р)
    let у = узел(вид_узла)
    у.оп = оп.текст
    у.левое = левое
    у.правое = дальше(р)
    левое = у
  }
  return левое
}

fn содержит(виды, вид) {
  for в in виды {
    if в == вид { return true }
  }
  return false
}

fn слияние(р) { return уровень(р, или_, "Logical", ["QQ"]) }

fn или_(р) { return уровень(р, и_, "Logical", ["OR"]) }

fn и_(р) { return уровень(р, равенство, "Logical", ["AND"]) }

fn равенство(р) { return уровень(р, сравнение, "Binary", ["EQ", "NEQ"]) }

fn сравнение(р) { return уровень(р, диапазон, "Binary", ["LT", "LTE", "GT", "GTE"]) }

fn диапазон(р) {
  let начало = сложение(р)
  if !это(р, "RANGE") { return начало }
  взять(р)
  let у = узел("Range")
  у.начало = начало
  у.конец = сложение(р)
  return у
}

fn сложение(р) { return уровень(р, умножение, "Binary", ["PLUS", "MINUS"]) }

fn умножение(р) { return уровень(р, унарное, "Binary", ["STAR", "SLASH", "PERCENT"]) }

fn унарное(р) {
  if это(р, "BANG") || это(р, "MINUS") {
    let оп = взять(р)
    let у = узел("Unary")
    у.оп = оп.вид == "BANG" ? "!" : "-"
    у.правое = унарное(р)
    return у
  }
  return степень(р)
}

// Степень правоассоциативна (2^3^2 == 2^(3^2)) и связывает крепче унарного
// минуса: -2^2 читается как -(2^2), как в математике.
fn степень(р) {
  let левое = постфикс(р)
  if !это(р, "CARET") { return левое }
  взять(р)
  let у = узел("Binary")
  у.оп = "^"
  у.левое = левое
  у.правое = унарное(р)
  return у
}

fn постфикс(р) {
  let e = первичное(р)
  while true {
    if это(р, "LPAREN") {
      взять(р)
      let аргументы = []
      while !это(р, "RPAREN") && !конец(р) {
        // Внутри скобок «{» снова может быть словарём.
        аргументы.push(в_скобках(р))
        if !совпало(р, ["COMMA"]) { break }
      }
      ожидать(р, "RPAREN", "«)» в конце списка аргументов")
      let у = узел("Call")
      у.вызываемое = e
      у.аргументы = аргументы
      e = у
    } else if это(р, "LBRACKET") {
      взять(р)
      let индекс = в_скобках(р)
      ожидать(р, "RBRACKET", "«]» после индекса")
      let у = узел("Index")
      у.объект = e
      у.индекс = индекс
      e = у
    } else if это(р, "DOT") {
      взять(р)
      let имя = ожидать(р, "IDENT", "имя поля или метода после «.»")
      let у = узел("Get")
      у.объект = e
      у.имя = имя.текст
      e = у
    } else {
      return e
    }
  }
  return e
}

// Внутри «(…)» и «[…]» запрет на словарь снимается: тела блока там быть не может.
fn в_скобках(р) {
  let сохранено = р.без_словаря
  р.без_словаря = 0
  let e = выражение(р)
  р.без_словаря = сохранено
  return e
}

fn первичное(р) {
  let т = текущая(р)

  if совпало(р, ["NUMBER"]) {
    let у = узел("Number")
    у.значение = num(предыдущая(р).текст)
    return у
  }
  if совпало(р, ["TRUE"]) {
    let у = узел("Bool")
    у.значение = true
    return у
  }
  if совпало(р, ["FALSE"]) {
    let у = узел("Bool")
    у.значение = false
    return у
  }
  if совпало(р, ["NIL"]) { return узел("Nil") }
  if совпало(р, ["IDENT"]) {
    let у = узел("Ident")
    у.имя = предыдущая(р).текст
    return у
  }

  if совпало(р, ["STRING"]) { return строка(предыдущая(р)) }
  if это(р, "FN") { return функция(р) }
  if это(р, "LPAREN") { return скобки(р) }
  if это(р, "LBRACKET") { return список(р) }

  if это(р, "LBRACE") {
    if р.без_словаря == 0 { return словарь(р) }
    // Здесь «{» уже занято телом if/while/for — словарь нужно отделить скобками.
    error("здесь «{» начинает тело блока — если это словарь, возьмите его в скобки: ({ ... })")
  }

  if т.вид == "NEWLINE" || т.вид == "EOF" {
    error("выражение оборвалось — ожидалось значение, строка ${т.строка}")
  }
  отказ(р, "значение")
  return nil
}

fn строка(лексема) {
  if лексема.части == nil {
    let у = узел("Str")
    у.значение = лексема.текст
    return у
  }
  let части = []
  for ч in лексема.части {
    if ч.вид == "текст" {
      части.push({текст: ч.текст})
    } else {
      части.push({выражение: подвыражение(ч.исходник)})
    }
  }
  let у = узел("Template")
  у.части = части
  return у
}

fn функция(р) {
  взять(р)
  let имя = это(р, "IDENT") ? взять(р).текст : nil
  let список_параметров = параметры(р)
  // «fn(x) -> x * 2» — тело-выражение с неявным return.
  if совпало(р, ["ARROW"]) {
    let у = лямбда(список_параметров, выражение(р))
    у.имя = имя
    return у
  }
  let у = узел("Fn")
  у.имя = имя
  у.параметры = список_параметров
  у.тело = блок(р)
  return у
}

fn скобки(р) {
  взять(р)
  // «(a, b) -> ...» — лямбда; отличаем от группировки по стрелке после «)».
  let л = попробовать_лямбду(р)
  if л != nil { return л }
  let e = в_скобках(р)
  ожидать(р, "RPAREN", "«)» в конце выражения в скобках")
  return e
}

fn попробовать_лямбду(р) {
  let начало = р.поз
  let имена = []
  while это(р, "IDENT") {
    имена.push(взять(р).текст)
    if !совпало(р, ["COMMA"]) { break }
  }
  if !(это(р, "RPAREN") && смотреть(р, 1).вид == "ARROW") {
    р.поз = начало
    return nil
  }
  взять(р)
  взять(р)
  let список_параметров = []
  for имя in имена { список_параметров.push(параметр(имя, nil)) }
  return лямбда(список_параметров, выражение(р))
}

fn список(р) {
  взять(р)
  let элементы = []
  let сохранено = р.без_словаря
  р.без_словаря = 0
  while !это(р, "RBRACKET") && !конец(р) {
    элементы.push(выражение(р))
    if !совпало(р, ["COMMA"]) { break }
  }
  р.без_словаря = сохранено
  ожидать(р, "RBRACKET", "«]» в конце списка")
  let у = узел("List")
  у.элементы = элементы
  return у
}

fn словарь(р) {
  ожидать(р, "LBRACE", "«{»")
  let пары = []
  let сохранено = р.без_словаря
  р.без_словаря = 0

  пропустить_разделители(р)
  while !это(р, "RBRACE") && !конец(р) {
    let ключ = ключ_словаря(р)
    ожидать(р, "COLON", "«:» между ключом и значением")
    пропустить_разделители(р)
    пары.push({ключ: ключ, значение: выражение(р)})
    пропустить_разделители(р)
    if !совпало(р, ["COMMA"]) { break }
    пропустить_разделители(р)
  }
  пропустить_разделители(р)

  р.без_словаря = сохранено
  ожидать(р, "RBRACE", "«}» в конце словаря")
  let у = узел("Map")
  у.пары = пары
  return у
}

fn ключ_словаря(р) {
  if это(р, "LBRACKET") {
    взять(р)
    let k = выражение(р)
    ожидать(р, "RBRACKET", "«]» после вычисляемого ключа")
    return k
  }
  if это(р, "STRING") {
    let k = взять(р)
    if k.части != nil { error("ключ словаря не может содержать вставку") }
    let у = узел("Str")
    у.значение = k.текст
    return у
  }
  if это(р, "NUMBER") {
    let у = узел("Number")
    у.значение = num(взять(р).текст)
    return у
  }
  if это(р, "TRUE") || это(р, "FALSE") {
    let у = узел("Bool")
    у.значение = взять(р).вид == "TRUE"
    return у
  }
  // Голый ключ — это строка, а не имя: «{имя: 1}» и «{"имя": 1}» — одно и то же.
  let у = узел("Str")
  у.значение = ожидать(р, "IDENT", "ключ словаря").текст
  return у
}
