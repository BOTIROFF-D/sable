// Лексер Sable, написанный на Sable.
//
// Это не показательный пример «смотрите, я умею в строки»: он разбирает тот же
// язык, на котором написан, и сверяется с настоящим лексером из src/lexer.ts на
// каждом файле репозитория. Совпали потоки лексем — значит языка действительно
// хватает на собственный перёд, а не только на задачки из учебника.
//
// Сверяются вид каждой лексемы, значение чисел, содержимое строк, правило
// значимого перевода строки, глубина скобок и вложенность комментариев.

struct Лексема {
  вид
  текст
  строка
  колонка
  // Куски строки со вставками: словари вида {вид: "текст", текст: …} и
  // {вид: "выражение", исходник: …, строка: …, колонка: …}. У обычной строки
  // здесь nil — по нему одну от другой и отличают.
  части = nil
}

// ---- классы символов -------------------------------------------------------

const ЦИФРЫ = "0123456789"
const ШЕСТНАДЦАТЬ = "0123456789abcdefABCDEF"

fn цифра(c) { return c != "" && ЦИФРЫ.contains(c) }

fn шестнадцатеричная(c) { return c != "" && ШЕСТНАДЦАТЬ.contains(c) }

// Латиница, добавочная латиница, кириллица и подчёркивание — те же диапазоны,
// что в настоящем лексере.
fn начало_имени(c) {
  if c == "" { return false }
  if c >= "a" && c <= "z" { return true }
  if c >= "A" && c <= "Z" { return true }
  if c == "_" { return true }
  if c >= "\u{00C0}" && c <= "\u{024F}" { return true }
  return c >= "\u{0400}" && c <= "\u{04FF}"
}

// Внутри имени дополнительно допустим тюркский окина: oʻquvchi, gʻalaba.
// Обычный апостроф сюда не входит — он занят под строковый литерал.
fn часть_имени(c) {
  if начало_имени(c) || цифра(c) { return true }
  return c == "\u{02BB}" || c == "\u{02BC}" || c == "\u{2018}" || c == "\u{2019}"
}

// ---- таблицы ---------------------------------------------------------------

const КЛЮЧЕВЫЕ = {
  "let": "LET", "const": "CONST", "fn": "FN", "return": "RETURN", "if": "IF", "else": "ELSE",
  "while": "WHILE", "for": "FOR", "in": "IN", "break": "BREAK", "continue": "CONTINUE",
  "true": "TRUE", "false": "FALSE", "nil": "NIL", "struct": "STRUCT", "import": "IMPORT",
  "as": "AS", "try": "TRY", "catch": "CATCH", "finally": "FINALLY", "and": "AND", "or": "OR",
  "not": "BANG",
}

// Виды, после которых перевод строки завершает инструкцию — правило как в Go.
const ЗАВЕРШАЮТ = {
  NUMBER: true, STRING: true, IDENT: true, TRUE: true, FALSE: true, NIL: true, RPAREN: true,
  RBRACKET: true, RBRACE: true, RETURN: true, BREAK: true, CONTINUE: true,
}

// ---- состояние разбора -----------------------------------------------------

struct Разбор {
  текст
  поз = 0
  строка = 1
  колонка = 1
  лексемы = []
  // Глубина «(» и «[»: внутри них перевод строки незначим.
  глубина = 0
  // Глубины, отложенные на входе в «{»: в теле блока перенос снова значим,
  // даже если блок стоит в аргументе вызова.
  стек = []
}

fn кончился(р) { return р.поз >= len(р.текст) }

fn текущий(р) {
  if р.поз >= len(р.текст) { return "" }
  return р.текст[р.поз]
}

fn следующий(р, сдвиг) {
  let i = р.поз + сдвиг
  if i >= len(р.текст) { return "" }
  return р.текст[i]
}

fn взять(р) {
  if р.поз >= len(р.текст) { return "" }
  let c = р.текст[р.поз]
  р.поз += 1
  if c == "\n" {
    р.строка += 1
    р.колонка = 1
  } else {
    р.колонка += 1
  }
  return c
}

fn совпало(р, ожидаемое) {
  let n = len(ожидаемое)
  if р.поз + n > len(р.текст) { return false }
  if р.текст.slice(р.поз, р.поз + n) != ожидаемое { return false }
  for _ in 0..n { взять(р) }
  return true
}

fn добавить(р, вид, текст, строка, колонка) { р.лексемы.push(Лексема(вид, текст, строка, колонка)) }

fn добавить_строку(р, текст, части, строка, колонка) {
  р.лексемы.push(Лексема("STRING", текст, строка, колонка, части))
}

// Перевод строки значим, только если предыдущая лексема могла закончить
// инструкцию и мы не внутри круглых или квадратных скобок.
fn перенос(р, строка, колонка) {
  if р.глубина > 0 { return nil }
  if len(р.лексемы) == 0 { return nil }
  if !ЗАВЕРШАЮТ.has(р.лексемы.last().вид) { return nil }
  добавить(р, "NEWLINE", "\\n", строка, колонка)
  return nil
}

// ---- комментарии -----------------------------------------------------------

fn строчный_комментарий(р) {
  while !кончился(р) && текущий(р) != "\n" { взять(р) }
}

// Блочные комментарии вкладываются друг в друга.
fn блочный_комментарий(р, строка) {
  let глубина = 1
  while глубина > 0 {
    if кончился(р) { error("блочный комментарий не закрыт (ожидалось «*/»)") }
    if совпало(р, "/*") {
      глубина += 1
    } else if совпало(р, "*/") {
      глубина -= 1
    } else {
      взять(р)
    }
  }
}

// ---- числа -----------------------------------------------------------------

fn число(р, первый, строка, колонка) {
  let запись = первый

  if первый == "0" && (текущий(р) == "x" || текущий(р) == "X") {
    запись += взять(р)
    while шестнадцатеричная(текущий(р)) || текущий(р) == "_" { запись += взять(р) }
    добавить(р, "NUMBER", str(num(запись.replace("_", ""))), строка, колонка)
    return nil
  }

  while цифра(текущий(р)) || текущий(р) == "_" { запись += взять(р) }

  // «1..5» — это диапазон, а не число с точкой: точку берём, только если
  // за ней идёт цифра.
  if текущий(р) == "." && цифра(следующий(р, 1)) {
    запись += взять(р)
    while цифра(текущий(р)) || текущий(р) == "_" { запись += взять(р) }
  }

  // Показатель степени берём, только если он есть целиком: «1e» без цифр —
  // это число 1 и следом имя «e», а не оборванная запись.
  if текущий(р) == "e" || текущий(р) == "E" {
    let знак = следующий(р, 1)
    let со_знаком = знак == "+" || знак == "-"
    let после = со_знаком ? следующий(р, 2) : знак
    if цифра(после) {
      запись += взять(р)
      if со_знаком { запись += взять(р) }
      while цифра(текущий(р)) { запись += взять(р) }
    }
  }

  // Бесконечности в языке нет: «1e999» — не число, а ошибка записи.
  let значение = num(запись.replace("_", ""), nil)
  if значение == nil { error("число «${запись}» слишком велико для языка") }
  добавить(р, "NUMBER", str(значение), строка, колонка)
  return nil
}

// ---- строки ----------------------------------------------------------------

const ПРОСТЫЕ_ЭКРАНЫ = {
  n: "\n", t: "\t", r: "\r", "0": "\u{0000}", "\\": "\\", "$": "$", "\"": "\"", "'": "'", "`": "`",
}

fn код_символа(р, строка) {
  if !совпало(р, "{") { error("после \\u ожидалось «{», например \\u{41}") }
  let hex = ""
  while текущий(р) != "}" && !кончился(р) { hex += взять(р) }
  if !совпало(р, "}") { error("escape \\u{...} не закрыт") }
  // Разбор «на глазок» проглотил бы хвост: «41zz» тихо стало бы «A».
  if len(hex) == 0 {
    error("некорректный код символа «${hex}» — ожидались шестнадцатеричные цифры")
  }
  for c in hex.chars() {
    if !шестнадцатеричная(c) {
      error("некорректный код символа «${hex}» — ожидались шестнадцатеричные цифры")
    }
  }
  let код = num("0x" + hex)
  if код > 1114111 { error("код символа «${hex}» больше предельного 10FFFF") }
  return char(код)
}

fn экран(р, строка) {
  let e = взять(р)
  if ПРОСТЫЕ_ЭКРАНЫ.has(e) { return ПРОСТЫЕ_ЭКРАНЫ.get(e) }
  if e == "u" { return код_символа(р, строка) }
  error("неизвестная escape-последовательность «\\${e}»")
  return ""
}

// Внутри вставки может быть своя строка, а в ней — фигурные скобки. Считать
// их за скобки вставки значит оборвать литерал посреди.
fn вставка(р, строка) {
  let исходник = ""
  let скобки = 1
  while скобки > 0 {
    if кончился(р) { error("вставка ${'$'}{...} не закрыта") }
    let c = текущий(р)

    if c == "\"" || c == "'" || c == "`" {
      исходник += взять(р)
      let закрыта = false
      while !закрыта {
        if кончился(р) { error("строка внутри вставки ${'$'}{...} не закрыта") }
        let d = текущий(р)
        if d == "\n" && c != "`" {
          error("строка внутри вставки ${'$'}{...} не закрыта до конца строки")
        }
        if d == "\\" {
          исходник += взять(р)
          исходник += взять(р)
          continue
        }
        исходник += взять(р)
        if d == c { закрыта = true }
      }
      continue
    }

    if c == "{" { скобки += 1 }
    if c == "}" {
      скобки -= 1
      if скобки == 0 {
        взять(р)
        continue
      }
    }
    исходник += взять(р)
  }
  if исходник.trim() == "" { error("пустая вставка ${'$'}{} — внутри нужно выражение") }
  return исходник
}

fn строка_литерал(р, кавычка, строка, колонка) {
  let многострочная = кавычка == "`"
  let текст = ""
  let части = []
  let вставок = 0
  let закрыта = false

  while !закрыта {
    if кончился(р) {
      if многострочная { error("строка в обратных кавычках не закрыта") }
      error("строка не закрыта до конца файла")
    }
    if !многострочная && текущий(р) == "\n" {
      error(
        "строка не закрыта до конца строки исходника — для многострочной используйте `обратные кавычки`",
      )
    }
    if текущий(р) == кавычка {
      взять(р)
      закрыта = true
      continue
    }

    if текущий(р) == "\\" {
      взять(р)
      текст += экран(р, строка)
      continue
    }
    if текущий(р) == "$" && следующий(р, 1) == "{" {
      // Накопленный кусок закрывается, только если он непустой: у «${a}${b}»
      // между вставками текста нет, и пустому куску там взяться неоткуда.
      if текст != "" {
        части.push({вид: "текст", текст: текст})
        текст = ""
      }
      взять(р)
      взять(р)
      let на_строке = р.строка
      let в_колонке = р.колонка
      let исходник = вставка(р, строка)
      части.push({вид: "выражение", исходник: исходник, строка: на_строке, колонка: в_колонке})
      вставок += 1
      continue
    }
    текст += взять(р)
  }

  // Пустая строка — тоже кусок текста: без него «""» осталось бы вовсе без
  // частей и стало бы неотличимо от строки со вставкой.
  if текст != "" || len(части) == 0 { части.push({вид: "текст", текст: текст}) }

  // У строки со вставками готового значения нет — она собирается при
  // выполнении. Сверять такие можно только по числу вставок.
  if вставок > 0 {
    добавить_строку(р, "@${вставок}", части, строка, колонка)
  } else {
    добавить(р, "STRING", текст, строка, колонка)
  }
  return nil
}

// ---- имена -----------------------------------------------------------------

fn имя(р, первый, строка, колонка) {
  let запись = первый
  while часть_имени(текущий(р)) { запись += взять(р) }
  добавить(р, КЛЮЧЕВЫЕ.get(запись, "IDENT"), запись, строка, колонка)
  return nil
}

// ---- знаки -----------------------------------------------------------------

const ОДИНОЧНЫЕ = {",": "COMMA", ":": "COLON", ";": "SEMI", "^": "CARET", "%": "PERCENT"}

// Знак, у которого есть двухсимвольный вариант. Запись лексемы обязана быть
// настоящей: парсер берёт из неё оператор, и «=» вместо «==» тихо сменило бы
// смысл выражения.
fn двузнак(р, первый, второй, вид_пары, вид_одиночки, строка, колонка) {
  if совпало(р, второй) {
    добавить(р, вид_пары, первый + второй, строка, колонка)
  } else {
    добавить(р, вид_одиночки, первый, строка, колонка)
  }
  return nil
}

fn знак(р, c, строка, колонка) {
  if ОДИНОЧНЫЕ.has(c) {
    добавить(р, ОДИНОЧНЫЕ.get(c), c, строка, колонка)
    return nil
  }

  if c == "(" {
    р.глубина += 1

    добавить(р, "LPAREN", c, строка, колонка)

    return nil
  }
  if c == ")" {
    р.глубина = max(0, р.глубина - 1)
    добавить(р, "RPAREN", c, строка, колонка)
    return nil
  }
  if c == "[" {
    р.глубина += 1
    добавить(р, "LBRACKET", c, строка, колонка)
    return nil
  }
  if c == "]" {
    р.глубина = max(0, р.глубина - 1)
    добавить(р, "RBRACKET", c, строка, колонка)
    return nil
  }

  if c == "{" {
    р.стек.push(р.глубина)
    р.глубина = 0
    добавить(р, "LBRACE", c, строка, колонка)
    return nil
  }
  if c == "}" {
    р.глубина = len(р.стек) > 0 ? р.стек.pop() : 0
    добавить(р, "RBRACE", c, строка, колонка)
    return nil
  }

  if c == "." {
    двузнак(р, c, ".", "RANGE", "DOT", строка, колонка)

    return nil
  }
  if c == "*" {
    двузнак(р, c, "=", "STAR_ASSIGN", "STAR", строка, колонка)
    return nil
  }
  if c == "+" {
    двузнак(р, c, "=", "PLUS_ASSIGN", "PLUS", строка, колонка)
    return nil
  }
  if c == "=" {
    двузнак(р, c, "=", "EQ", "ASSIGN", строка, колонка)
    return nil
  }
  if c == "!" {
    двузнак(р, c, "=", "NEQ", "BANG", строка, колонка)
    return nil
  }
  if c == "<" {
    двузнак(р, c, "=", "LTE", "LT", строка, колонка)
    return nil
  }
  if c == ">" {
    двузнак(р, c, "=", "GTE", "GT", строка, колонка)
    return nil
  }
  if c == "?" {
    двузнак(р, c, "?", "QQ", "QUESTION", строка, колонка)
    return nil
  }

  if c == "-" {
    if совпало(р, "=") {
      добавить(р, "MINUS_ASSIGN", "-=", строка, колонка)
      return nil
    }
    двузнак(р, c, ">", "ARROW", "MINUS", строка, колонка)
    return nil
  }

  if c == "&" {
    if !совпало(р, "&") { error("одиночный «&» не является оператором — вы имели в виду «&&»?") }
    добавить(р, "AND", "&&", строка, колонка)
    return nil
  }
  if c == "|" {
    if !совпало(р, "|") { error("одиночный «|» не является оператором — вы имели в виду «||»?") }
    добавить(р, "OR", "||", строка, колонка)
    return nil
  }

  error("неизвестный символ «${c}»")
  return nil
}

// ---- главный проход --------------------------------------------------------

fn разобрать(исходник) {
  let р = Разбор(исходник)

  while !кончился(р) {
    let строка = р.строка
    let колонка = р.колонка
    let c = взять(р)

    if c == " " || c == "\t" || c == "\r" { continue }
    if c == "\n" {
      перенос(р, строка, колонка)
      continue
    }

    if c == "/" {
      if совпало(р, "/") {
        строчный_комментарий(р)
        continue
      }
      if совпало(р, "*") {
        блочный_комментарий(р, строка)
        continue
      }
      двузнак(р, c, "=", "SLASH_ASSIGN", "SLASH", строка, колонка)
      continue
    }

    if c == "\"" || c == "'" || c == "`" {
      строка_литерал(р, c, строка, колонка)

      continue
    }
    if цифра(c) {
      число(р, c, строка, колонка)
      continue
    }
    if начало_имени(c) {
      имя(р, c, строка, колонка)
      continue
    }

    знак(р, c, строка, колонка)
  }

  перенос(р, р.строка, р.колонка)
  добавить(р, "EOF", "", р.строка, р.колонка)
  return р.лексемы
}

// Каноническая запись потока — ровно та же, что сверяющий тест печатает для
// настоящего лексера. Сравнивать удобно построчно.
fn канон(лексемы) {
  let строки = []
  for л in лексемы {
    if л.вид == "NEWLINE" || л.вид == "EOF" {
      строки.push(л.вид)
    } else {
      строки.push("${л.вид} ${л.текст}")
    }
  }
  return строки.join("\n")
}
