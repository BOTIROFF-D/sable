// Гоняет самодельный лексер по файлам, пути к которым переданы в командной
// строке. Для каждого печатает заголовок «=== путь», затем поток лексем в
// канонической записи.
//
// Файл с намеренно битым синтаксисом — не сбой, а тоже результат: вместо потока
// лексем печатается «!!! отказ». Сверяющий тест требует, чтобы настоящий лексер
// отказался ровно на тех же файлах.

import "lexer.sable" as лексер

if len(args()) == 0 { print("укажите файлы .sable в командной строке") }

for путь in args() {
  print("=== " + путь)
  try {
    print(лексер.канон(лексер.разобрать(read_file(путь))))
  } catch {
    print("!!! отказ")
  }
}
