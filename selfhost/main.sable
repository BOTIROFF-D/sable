// Гоняет самодельный лексер по файлам, пути к которым приходят на вход —
// по одному в строке. Для каждого печатает заголовок «=== путь», затем поток
// лексем в канонической записи.
//
// Пути приходят потоком, а не аргументами командной строки, ровно по одной
// причине: доступа к аргументам у программы на Sable пока нет. Это первое,
// чего не хватило самоприменению, и первый кандидат в язык.
//
// Файл с намеренно битым синтаксисом — не сбой, а тоже результат: вместо
// потока лексем печатается «!!! отказ». Сверяющий тест требует, чтобы
// настоящий лексер отказался ровно на тех же файлах.

import "lexer.sable" as лексер

let строка_ввода = input()
while строка_ввода != nil {
  let путь = строка_ввода.trim()
  if путь != "" {
    print("=== " + путь)
    try {
      print(лексер.канон(лексер.разобрать(read_file(путь))))
    } catch {
      print("!!! отказ")
    }
  }
  строка_ввода = input()
}
