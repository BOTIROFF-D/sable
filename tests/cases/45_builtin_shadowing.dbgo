// Встроенные имена лежат во внешней области — своё объявление их затеняет,
// а не спорит с ними. Иначе банальное `let sum = 0` не написать.
let sum = 0
for i in 1..5 { sum += i }
print(sum)

let log = ["первая запись"]
log.push("вторая")
print(log.len(), log.last())

// Затенение действует и в своей области, снаружи встроенное на месте
fn считать(xs) {
  let max = xs.first()
  for x in xs { if x > max { max = x } }
  return max
}
print(считать([3, 9, 2]), max(3, 9, 2))

// const поверх встроенного тоже можно
const pi = 3.14159
print(pi)

// Внутри блока затенение не протекает наружу
{
  let str = "внутри"
  print(str)
}
print(str(42))
