// Ошибку ловить некому: finally отрабатывает, ошибка летит дальше и
// останавливает программу — со своим местом и стеком вызовов.
fn прибраться() { print("finally: прибрались") }

fn работа() {
  try {
    print("работа началась")
    error("работа сорвалась")
  } finally { прибраться() }
}

работа()
print("эта строка не выполнится")
