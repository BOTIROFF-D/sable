// Проверка обещаний из docs/LANGUAGE.md — чтобы документация не разошлась с языком

// имена на кириллице и узбекской латинице
let счётчик = 0
счётчик += 1
let oʻquvchi = "talaba"
print(счётчик, oʻquvchi)

struct Студент { имя, оплачено = 0
  fn должник() { return self.оплачено == 0 }
}
let s = Студент("Ali")
print(s.должник(), s)

// перенос строки внутри скобок и после оператора
let total = 1 +
            2 +
            3
print(total)
print([
  1,
  2,
], max(
  4,
  5
))

// две инструкции через точку с запятой
let a = 1; let b = 2
print(a, b)

// словесные операторы
print(not false, true and true, false or true)

// вложенные блочные комментарии
/* внешний /* внутренний */ всё ещё комментарий */
print("после комментария")

// значение по умолчанию видит предыдущий параметр
fn площадь(ширина, высота = ширина) { return ширина * высота }
print(площадь(3), площадь(3, 4))

// взаимная рекурсия при вызове после обоих объявлений
fn чёт(n) { if n == 0 { return true }; return нечёт(n - 1) }
fn нечёт(n) { if n == 0 { return false }; return чёт(n - 1) }
print(чёт(10), нечёт(10))

// диапазон ленив: миллион не материализуется
let big = 0..1000000
print(big.len(), big[999999])

// сравнение по содержимому
print([1, [2]] == [1, [2]], {a: {b: 1}} == {a: {b: 1}}, Студент("Ali") == Студент("Ali"))

// ложны только false и nil
print(bool(0), bool(""), bool([]), bool(false), bool(nil))
