let xs = [3, 1, 2]
print(xs.len(), xs.first(), xs.last(), xs[0], xs[-1])
print(xs.sort(), xs)
print(xs.sort((a, b) -> b - a))
print(xs.map(x -> x * 10), xs.filter(x -> x > 1), xs.reduce((a, b) -> a + b, 0))
print(xs.any(x -> x > 2), xs.all(x -> x > 0), xs.find(x -> x > 1))
print(xs.contains(2), xs.index_of(2), xs.index_of(99))
print(xs.slice(1), xs.slice(0, 2), xs.reverse(), xs.clone())
let ys = [1, 2, 3]
ys.push(4)
ys.push(5, 6)
print(ys)
let taken = ys.pop()
print(taken, ys)
ys.insert(0, 0)
print(ys)
let dropped = ys.remove_at(0)
print(dropped, ys)
print([[1, 2], [3]].map(g -> g.len()))
let grid = [[1, 2], [3, 4]]
grid[1][0] = 99
print(grid)
print(["б", "а", "в"].sort())
