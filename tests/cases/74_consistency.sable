// Мелкие правила, которые язык обещает всем и должен соблюдать везде.
fn поймать(f) { try { return str(f()) } catch e { return e.message } }

// Дополнение считается в символах, как len и slice
print("|" + "😀бот".pad_end(8) + "|", "😀бот".pad_end(8).len())
print("x".pad_start(5, "😀").len(), "7".pad_start(3, "0"))

// Отрицательная позиция считается с конца — и у insert тоже
let xs = [1, 2, 3]
xs.insert(-1, 9)
print(xs)
let снятое = xs.remove_at(-1)
print(снятое, xs)

// Диапазон — это последовательность целых, а не отрезок
print((0..5).contains(2), (0..5).contains(2.5), (0..5).contains(5))

// Ключи, неразличимые в JSON, не должны молча терять запись
print(поймать(() -> to_json({ 1: "a", "1": "b" })))
print(to_json({ имя: "Ali", лет: 20 }))

// Большие списки строятся без чужих сообщений об ошибках
print((range(0, 200000) * 2).len(), [range(0, 300000)].flat_map(x -> x).len())
