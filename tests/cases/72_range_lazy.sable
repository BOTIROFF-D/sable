// Диапазон ленив: индексация не должна разворачивать его в список.
// Раньше (0..1000000000)[0] съедал всю память и ронял процесс.
let r = 0..1000000000
print(len(r), r[0], r[999999999], r[-1])
print((5..10)[2], (5..10)[-2])

fn поймать(f) { try { return str(f()) } catch e { return e.message } }
print(поймать(() -> (0..5)[9]))
print(поймать(() -> (0..5)[-9]))
