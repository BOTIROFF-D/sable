// Структуры и списки вправе ссылаться друг на друга: сравнение и печать
// обязаны с этим справляться, а JSON — сказать понятную ошибку, а не сорвать стек.
struct Узел { имя, сосед = nil }

let a1 = Узел("a"); let b1 = Узел("b")
a1.сосед = b1; b1.сосед = a1
let a2 = Узел("a"); let b2 = Узел("b")
a2.сосед = b2; b2.сосед = a2
print(a1 == a2, a1 == b1)

let сам = Узел("сам")
сам.сосед = сам
print(сам == сам, repr(сам))

let x = [1]; x.push(x)
let y = [1]; y.push(y)
print(x == y, len(x))
try { print(to_json(x)) } catch e { print("json:", e.message) }

// обычное равенство не задето
print([1, 2] == [1, 2], [1, 2] == [1, 3], {a: 1} == {a: 1})
