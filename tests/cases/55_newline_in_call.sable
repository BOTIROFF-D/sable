// Внутри «(» переводы строк незначимы — так длинный вызов можно разложить.
// Но внутри «{» они снова значимы, даже если блок стоит в аргументе вызова:
// иначе тело функции слипалось бы в одну инструкцию.
fn применить(g, v) { return g(v) }

print(
  применить(fn(x) {
    let удвоено = x * 2
    return удвоено + 1
  }, 20)
)

let числа = [1, 2, 3]
print(числа.map(fn(x) {
  let q = x * x
  return q
}))

// длинный вызов по-прежнему раскладывается по строкам
print(
  1,
  2,
  3,
)

// и словарь внутри скобок остаётся словарём
print({
  a: 1,
  b: 2,
})
