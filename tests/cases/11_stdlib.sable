print(len("абв"), len([1, 2]), len({a: 1}), len(0..4))
print(str(1), str(nil), str([1, 2]), num("42"), num("3.5"), num("нет", -1), num(true))
print(int(3.9), int(-3.9), abs(-5), floor(1.7), ceil(1.2), sqrt(16), pow(2, 8))
print(round(2.5), round(3.14159, 2), round(-2.5))
print(min(3, 1, 2), max(3, 1, 2), min([4, 2, 9]), max([4, 2, 9]))
print(bool(0), bool(nil), bool(false), bool(""))
print(to_json([1, {a: nil}]))
print(to_json({b: 1}, 2))
let parsed = from_json("{\"list\": [1, 2], \"nested\": {\"k\": true}}")
print(parsed.list, parsed.nested.k, type(parsed))
print(sum(map(1..5, x -> x)))
print(reduce([1, 2, 3], (a, b) -> a * b, 1))
