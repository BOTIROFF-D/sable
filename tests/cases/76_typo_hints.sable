// Подсказка про опечатку обещана README как возможность языка — она должна
// быть везде, где имя ищется, а не только у переменных.
fn поймать(f) { try { return f() } catch e { return e.message } }

print(поймать(() -> "abc".uppr()))
print(поймать(() -> [1, 2].pushh(3)))
print(поймать(() -> (0..3).lenn()))

let u = { имя: "Ali", возраст: 20 }
print(поймать(() -> u.имя2))

struct Точка { x, y
  fn длина() { return sqrt(self.x ^ 2 + self.y ^ 2) }
}
let p = Точка(3, 4)
print(поймать(() -> p.длна()))
print(поймать(() -> p.z))

// когда похожего имени нет, подсказки быть не должно
print(поймать(() -> "abc".шчщ()))
