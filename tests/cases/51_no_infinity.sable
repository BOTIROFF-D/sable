// В языке нет бесконечности и «не числа»: раз деление на ноль — ошибка,
// то и переполнение должно быть ошибкой, а не тихим inf, который потом
// всплывёт в JSON как null.
fn поймать(f) { try { return str(f()) } catch e { return e.message } }

print(поймать(() -> 0 ^ -1))
print(поймать(() -> pow(0, -1)))
print(поймать(() -> 1e308 * 10))
print(поймать(() -> round(1e308, 2)))
print(поймать(() -> exp(1000)))
print(поймать(() -> 1 / 0))
print(поймать(() -> 0..(1e308 * 10)))
print(поймать(() -> "a" * 1000000000))
print(поймать(() -> [1] * 1000000000))

// диапазон за пределом точных целых: счётчик перестал бы расти
print(поймать(() -> 0..1e308))
print(поймать(() -> range(0, 1e308)))

// обычные вычисления не задеты
print(2 ^ 100, pow(2, 10), round(2.5), exp(1), hypot(3, 4), 10 / 4)
