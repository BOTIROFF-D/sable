// Вызов с посчитанным списком аргументов. Без него нельзя ни перенаправить
// чужой вызов, ни позвать функцию, число аргументов которой выяснится только
// при выполнении: развёртки списка в языке нет.
fn сумма(a, b, c = 10) { return a + b + c }
print(apply(сумма, [1, 2]), apply(сумма, [1, 2, 3]))

// Встроенные с переменным числом аргументов тоже зовутся.
print(apply(max, [3, 9, 4]), apply(min, [3, 9, 4]))
apply(print, ["раз", 2, true])

// Число аргументов проверяется как при обычном вызове, а не подрезается.
try { print(apply(сумма, [1])) } catch e { print(e.message) }
try { print(apply(сумма, [1, 2, 3, 4])) } catch e { print(e.message) }

// Список принадлежит зовущему: вызываемое его не портит.
let аргументы = [1, 2]
fn портит(a, b) {
  return a + b
}
print(apply(портит, аргументы), аргументы)

// Перенаправление вызова — то, ради чего это и нужно.
fn через_журнал(f, аргументы) {
  print("зову с", len(аргументы), "аргументами")
  return apply(f, аргументы)
}
print(через_журнал(сумма, [5, 5, 5]))

try { print(apply(42, [])) } catch e { print(e.message) }
try { print(apply(сумма, 1)) } catch e { print(e.message) }
