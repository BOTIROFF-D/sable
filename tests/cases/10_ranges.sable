let r = 0..5
print(r, r.len(), r.list(), r.contains(4), r.contains(5))
print(r[0], r[-1])
let total = 0
for i in 2..6 { total += i }
print(total)
print((0..0).len(), (5..1).len())
let n = 3
print((1..n + 1).list())
print(range(3), range(2, 5), range(0, 10, 3), range(5, 0, -1))
print(sum(0..5), sum([1, 2, 3]))
print(map(0..3, x -> x * x), filter(0..6, x -> x % 2 == 0))
