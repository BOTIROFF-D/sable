// Составное присваивание вычисляет цель ровно один раз.
let счётчик = 0
fn next() { счётчик += 1; return счётчик - 1 }

let xs = [10, 20]
xs[next()] += 5
print(xs, счётчик)

let вызовов = 0
fn дай(m) { вызовов += 1; return m }
let m = { n: 1 }
дай(m).n += 5
print(m, вызовов)

let s = { a: 2 }
s["a"] *= 10
print(s)

let l = [1, 2]
l[-1] -= 1
print(l)

let k = 10
k /= 4
print(k)
