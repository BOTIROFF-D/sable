// Бесконечность не должна входить в язык ни одним путём: справочник обещает,
// что её нет, и что она не всплывёт в JSON как null.
fn поймать(f) { try { return str(f()) } catch e { return e.message } }

print(поймать(() -> num("1e999")))
print(поймать(() -> num("Infinity")))
print(поймать(() -> from_json("1e999")))
print(поймать(() -> from_json("[1, 1e999]")))

// обычные числа не задеты
print(1e308, num("42"), num("3.5"), from_json("[1, 2.5]"))
