fn classify(n) {
  if n < 0 { return "минус" }
  else if n == 0 { return "ноль" }
  else { return "плюс" }
}
print(classify(-1), classify(0), classify(5))

let out = []
for i in 0..5 {
  if i == 1 { continue }
  if i == 4 { break }
  out.push(i)
}
print(out)

let k = 0
while true { k += 1; if k >= 3 { break } }
print(k)

let m = []
for a in 1..3 { for b in 1..3 { m.push("${a}${b}") } }
print(m)

for ch in "абв" { write(ch, "") }
print("")

for key in ({ x: 1, y: 2 }) { write(key, "") }
print("")

// 0 и "" истинны — ложны только false и nil
if 0 { print("ноль истинен") }
if "" { print("пустая строка истинна") }
if !nil { print("nil ложен") }

// словарь в заголовке цикла требует скобок — иначе «{» это тело
let m2 = { a: 1, b: 2 }
for key in m2 { write(key, "") }
print("")
